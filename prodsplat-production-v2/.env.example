# Local-only production deployment. The launcher replaces this placeholder automatically.
INTERNAL_TOKEN=replace-with-random-token
APP_PORT=8080
WORKSPACE=/workspace
TASK_LEASE_SECONDS=45
MAX_UPLOAD_BYTES=4294967296

# Default reconstruction profile (can be overridden per upload in the UI)
DEFAULT_PROFILE=balanced

# Worker connects to the Go control plane over the private Compose network.
APP_INTERNAL_URL=http://app:8080
WORKER_POLL_SECONDS=2
WORKER_HEARTBEAT_SECONDS=5

# COLMAP policy: GPU first. If SiftGPU/CUDA matching hits a known runtime error,
# only the matcher retries on CPU; Splatfacto/gsplat remain GPU-backed.
PRODSPLAT_GPU_INDEX=0
PRODSPLAT_MAX_NUM_MATCHES=32768
PRODSPLAT_COLMAP_CPU_FALLBACK=1

# Auto-isolate (render option for video attempts). Distances are fractions of the
# camera orbit radius: keep a cylinder around the cameras' focus, cut at the
# densest horizontal layer below the product plus a margin, then trim everything
# outside the product's own footprint grown by the last factor.
PRODSPLAT_ISOLATE_CYLINDER=0.40
PRODSPLAT_ISOLATE_PLANE_MARGIN=0.03
PRODSPLAT_ISOLATE_BODY_START=0.08
PRODSPLAT_ISOLATE_FOOTPRINT=1.08
